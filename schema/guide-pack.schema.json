{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathology.local/guide-pack.schema.json",
  "title": "Pathology Guide Pack",
  "type": "object",
  "description": "Top-level description is informational; validate manifest.json, toc.json, and pages separately via tool/guide_validate.",
  "definitions": {
    "manifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "packId",
        "version",
        "minAppVersion",
        "defaultLocale",
        "locales"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "packId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "minAppVersion": {
          "type": "string",
          "minLength": 1
        },
        "maxAppVersion": {
          "type": "string"
        },
        "defaultLocale": {
          "type": "string",
          "minLength": 2
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "generatedAt": {
          "type": "string"
        },
        "ota": {
          "type": "object"
        },
        "files": {
          "type": "object",
          "description": "Per-leaf sha256/size map used by the client's leaf-based OTA. Regenerated by tool/guide_manifest.py.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "sha256",
              "size"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "block": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "heading",
            "paragraph",
            "richText",
            "list",
            "link",
            "routeLink",
            "guideLink",
            "navTile",
            "icon",
            "image",
            "callout",
            "demoStub",
            "interactive",
            "expandable",
            "video",
            "illustration",
            "anchorRef"
          ]
        }
      }
    }
  }
}
